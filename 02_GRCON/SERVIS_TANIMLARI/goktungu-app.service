[Unit]
Description=GOKTUNGU Yer Kontrol Istasyonu (merkez /app/)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=goktungu
Group=goktungu
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/goktungu /var/log
WorkingDirectory=/opt/goktungu/app
Environment=GOKTUNGU_HTTP_PORT=18000
Environment=GOKTUNGU_WS_PORT=18765
Environment=PYTHONUNBUFFERED=1
Environment=GOKTUNGU_MERKEZ_KIMLIK=1
EnvironmentFile=-/etc/goktungu/goktungu.env
ExecStart=/usr/bin/python3.11 /opt/goktungu/app/main.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/goktungu-app.log
StandardError=append:/var/log/goktungu-app.log

[Install]
WantedBy=multi-user.target
