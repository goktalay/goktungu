# Bu dosyayı /etc/goktungu/goktungu.env olarak kopyalayın.
# Dosya izinleri: root:root ve 0600 olmalıdır.
# Gerçek kullanıcı adı, parola, ana bilgisayar ve veritabanı adını hedef kurulumda girin.
GOKTUNGU_MERKEZ_DSN=postgresql://KULLANICI:PAROLA@127.0.0.1:5432/goktungu_merkez

# İsteğe bağlı çalışma kimliği; gerçek kurulum değerini hedef ortamda üretin.
# GOKTUNGU_KURULUM_ID=ornek-kurulum-kimligi
