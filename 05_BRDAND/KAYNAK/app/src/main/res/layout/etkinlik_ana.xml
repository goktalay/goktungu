<?xml version="1.0" encoding="utf-8"?>
<!--
  GOKTUNGU MAVLink Koprusu — ana ekran.

  Tasarim v3 taktik temaya baglidir (merkez arayuzle ayni palet):
  zemin #04070C, siyan #5CC8FF, kehribar #F2B24A, vurgu #B91C1C.
  Basliklar baslik_renk kullanir; #ffffff sabiti YAZILMAZ.
  Tum dokunma hedefleri en az 48dp (WCAG / Play erisilebilirlik).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zemin"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ust serit -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/uygulama_adi"
                    android:textAppearance="@style/Metin.Baslik"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/uygulama_alt_adi"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/siyan"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/dgHakkinda"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/hakkinda_baslik"
                android:textColor="@color/soluk"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Durum karti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/kart_zemin"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/durum_baslik"
                android:textAppearance="@style/Metin.Mono"
                android:textColor="@color/kehribar"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/etiketUsb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/durum_usb_yok"
                android:textAppearance="@style/Metin.Govde"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/etiketArac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/durum_arac_yok"
                android:textAppearance="@style/Metin.Govde"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/etiketMerkez"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/durum_merkez_kopuk"
                android:textAppearance="@style/Metin.Govde"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/etiketSayac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tel_deger_yok"
                android:textAppearance="@style/Metin.Mono"
                android:textColor="@color/soluk"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Yapilandirma karti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/kart_zemin"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yapilandirma_baslik"
                android:textAppearance="@style/Metin.Mono"
                android:textColor="@color/kehribar"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alan_cihaz"
                android:textAppearance="@style/Metin.Govde"
                android:textColor="@color/soluk"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/secimCihaz"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:popupBackground="@color/zemin_yukseltilmis" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/alan_hiz"
                        android:textAppearance="@style/Metin.Govde"
                        android:textColor="@color/soluk"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/secimHiz"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:popupBackground="@color/zemin_yukseltilmis" />
                </LinearLayout>

                <Button
                    android:id="@+id/dgTara"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:minWidth="88dp"
                    android:text="@string/dg_tara"
                    android:textColor="@color/siyan"
                    style="?android:attr/buttonStyle" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alan_adres"
                android:textAppearance="@style/Metin.Govde"
                android:textColor="@color/soluk"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/girisAdres"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/ipucu_adres"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:textColor="@color/govde_renk"
                android:textColorHint="@color/soluk"
                android:autofillHints=""
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alan_port"
                android:textAppearance="@style/Metin.Govde"
                android:textColor="@color/soluk"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/girisPort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/ipucu_port"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textColor="@color/govde_renk"
                android:textColorHint="@color/soluk"
                android:autofillHints=""
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/kutuOto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/alan_oto_baglan"
                android:textColor="@color/govde_renk" />
        </LinearLayout>

        <!-- Denetim dugmeleri -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/dgBaglan"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/dg_baglan"
                android:textStyle="bold"
                android:textColor="@color/baslik_renk"
                android:backgroundTint="@color/vurgu" />

            <Button
                android:id="@+id/dgKes"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/dg_kes"
                android:textColor="@color/govde_renk" />
        </LinearLayout>

        <!-- Telemetri karti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/kart_zemin"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/telemetri_baslik"
                android:textAppearance="@style/Metin.Mono"
                android:textColor="@color/kehribar"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/etiketTelemetri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tel_konum_yok"
                android:textAppearance="@style/Metin.Mono"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Gunluk karti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/kart_zemin"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gunluk_baslik"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/kehribar"
                    android:textSize="11sp"
                    android:letterSpacing="0.12" />

                <Button
                    android:id="@+id/dgGunlukTemizle"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:text="@string/dg_gunluk_temizle"
                    android:textColor="@color/soluk"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/etiketGunluk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gunluk_bos"
                android:textAppearance="@style/Metin.Mono"
                android:textColor="@color/soluk"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
