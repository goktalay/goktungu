<?xml version="1.0" encoding="utf-8"?>
<!-- Sol menü başlığı (NavigationView headerLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/zemin_yukseltilmis"
    android:padding="16dp"
    android:paddingTop="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_ust"
        android:textAppearance="@style/Metin.Baslik"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_alt"
        android:textAppearance="@style/Metin.Mono"
        android:textColor="@color/siyan"
        android:textSize="12sp"
        android:paddingTop="2dp" />
</LinearLayout>
