<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ag: merkez sunucuya GDP baglantisi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Konum: MSDK aracin konumunu okumak icin ister; ayrica bazi
         araclar cihaz konumu olmadan ucus izni vermez -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- USB: kumanda kabloyla baglanir -->
    <uses-permission android:name="android.permission.USB_PERMISSION"
        tools:ignore="ProtectedPermissions" />

    <!-- Ucus surerken koprunun kapanmamasi icin on plan hizmeti -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- MSDK gereksinimleri.

         OLCULDU: MSDK 5.18.0'in kendi manifesti usb.accessory icin
         android:required="true" bildiriyor ve manifest birlestirmede
         bizim "false" degerimizi eziyor.  Sonuc: USB aksesuar destegi
         bildirmeyen tabletler/telefonlar Play Store'da uygulamayi HIC
         GORMEZ.  DJI araci Wi-Fi ile de baglanabildigi icin bu kisit
         gereksiz; tools:replace ile geri aliniyor. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="false"
        tools:replace="android:required" />

    <application
        android:name=".GoktunguUygulama"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/uygulama_adi"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Tema.Goktungu"
        android:networkSecurityConfig="@xml/ag_guvenligi"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic,android:allowBackup"
        tools:targetApi="35">

        <!-- DJI API anahtari.  Deger build.gradle icindeki
             manifestPlaceholders'tan gelir; yerel.properties veya
             DJI_API_ANAHTARI cevre degiskeninden okunur.  Bos olabilir;
             o durumda SDK kaydi basarisiz olur ve arayuz bunu ACIKCA
             bildirir (sessiz cokme yok). -->
        <meta-data
            android:name="com.dji.sdk.API_KEY"
            android:value="${DJI_API_ANAHTARI}" />

        <activity
            android:name=".arayuz.AnaEtkinlik"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Kumanda USB ile baglaninca uygulamayi one al -->
            <intent-filter>
                <action
                    android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/usb_aksesuar_filtresi" />
        </activity>

        <!-- Ucus surerken koprunun yasamasini saglayan on plan hizmeti -->
        <service
            android:name=".kopru.KopruHizmeti"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
