<?xml version="1.0" encoding="utf-8"?>
<!--
  Ag guvenlik yapilandirmasi.

  Neden duz metin gerekli: kullanici merkez yazilimi kapali devre
  (yerel ag) calistirabilir; o kurulumda TLS sertifikasi bulunmaz ve
  baglanti duz metin olmak zorundadir.

  Neden burada genel izin var: Android `domain-config` yalniz tek tek
  ad/IP kabul eder, CIDR araligi KABUL ETMEZ.  Kullanicinin yerel
  sunucusu 192.168.8.186 gibi herhangi bir adres olabilecegi icin
  adresleri onceden listelemek olanaksizdir.

  Guvenlik nerede saglaniyor: kisitlama KODDA uygulanir.
  `veri/AgKisiti.kt` icindeki `duzMetinIzinliMi()` yalnizca RFC 1918
  ozel ag adreslerine (10/8, 172.16/12, 192.168/16), bagli-yerel
  (169.254/16) ve dongu adresine duz metin izni verir.  Genel internet
  adreslerinde TLS zorunlu tutulur ve baglanti reddedilir.
  Bu davranis birim olcumuyle dogrulanir.

  Not: MSDK kendi manifestinde usesCleartextTraffic=false bildirir;
  tools:replace ile eziliyor.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
