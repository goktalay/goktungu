<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Tema.Goktungu" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/siyan</item>
        <item name="colorOnPrimary">@color/zemin</item>
        <item name="colorSecondary">@color/kehribar</item>
        <item name="colorOnSecondary">@color/zemin</item>
        <item name="colorError">@color/kotu</item>
        <item name="android:colorBackground">@color/zemin</item>
        <item name="colorSurface">@color/zemin_kart</item>
        <item name="colorOnSurface">@color/govde_renk</item>
        <item name="android:statusBarColor">@color/zemin</item>
        <item name="android:navigationBarColor">@color/zemin</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/baslik_renk</item>
        <item name="android:textColorSecondary">@color/soluk</item>
    </style>

    <style name="Metin.Baslik" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/baslik_renk</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Metin.AltBaslik" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/siyan</item>
    </style>

    <style name="Metin.Govde" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/govde_renk</item>
    </style>

    <style name="Metin.Soluk" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/soluk</item>
    </style>

    <style name="Metin.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/govde_renk</item>
    </style>
</resources>
