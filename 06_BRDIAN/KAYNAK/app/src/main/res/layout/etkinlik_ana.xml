<?xml version="1.0" encoding="utf-8"?>
<!--
  GOKTUNGU Goruntu Koprusu (BRDIAN) — ana ekran (tek ekran).

  BRDAND'daki cok-kopru sol menusu (DrawerLayout + NavigationView)
  BURADA YOKTUR: BRDIAN tek amaclidir (goruntu koprusu). Ekran sirasi:
  kamera onizleme -> durum -> kurulum (GRCON/GRCOFF + API kodu) -> kimlik
  -> gunluk.

  Tasarim v3 taktik temaya baglidir (colors.xml marka sozlesmesi):
  zemin #04070C, siyan #5CC8FF, kehribar #F2B24A, vurgu #B91C1C.
  Dokunma hedefleri en az 48dp.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/zemin">

    <!-- Ust serit: baslik + hakkinda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/zemin_kart"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/uygulama_adi"
                android:textAppearance="@style/Metin.Baslik"
                android:textStyle="bold"
                android:textSize="16sp"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/uygulama_alt_adi"
                android:textAppearance="@style/Metin.Mono"
                android:textColor="@color/kehribar"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/dgHakkinda"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="@string/hakkinda_baslik"
            android:textColor="@color/soluk"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Onizleme karti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/kart_zemin"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/onizleme_baslik"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/kehribar"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:paddingBottom="8dp" />

                <androidx.camera.view.PreviewView
                    android:id="@+id/onizleme"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@color/zemin_yukseltilmis" />

                <TextView
                    android:id="@+id/etiketKamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/durum_kamera_yok"
                    android:textAppearance="@style/Metin.Mono"
                    android:textSize="11sp"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Durum karti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/kart_zemin"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/durum_baslik"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/kehribar"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/etiketMerkez"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/durum_merkez_kopuk"
                    android:textAppearance="@style/Metin.Govde"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/etiketKanal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/durum_kanal_yok"
                    android:textAppearance="@style/Metin.Govde"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/etiketSayac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tel_deger_yok"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/soluk"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- KURULUM karti (kimlik yokken) -->
            <LinearLayout
                android:id="@+id/kartKurulum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/kart_zemin"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kurulum_baslik"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/kehribar"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kurulum_aciklama"
                    android:textAppearance="@style/Metin.Govde"
                    android:textColor="@color/govde_renk"
                    android:textSize="13sp"
                    android:paddingBottom="8dp" />

                <RadioGroup
                    android:id="@+id/grupSecim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioGrcon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/kurulum_grcon"
                        android:textColor="@color/govde_renk" />

                    <RadioButton
                        android:id="@+id/radioGrcoff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/kurulum_grcoff"
                        android:textColor="@color/govde_renk" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alan_kod"
                    android:textAppearance="@style/Metin.Govde"
                    android:textColor="@color/soluk"
                    android:textSize="12sp"
                    android:paddingTop="6dp" />

                <EditText
                    android:id="@+id/girisKod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:gravity="top|start"
                    android:hint="@string/ipucu_kod"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:textColor="@color/govde_renk"
                    android:textColorHint="@color/soluk"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:autofillHints=""
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/etiketKurulumNot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kurulum_not_grcon"
                    android:textColor="@color/soluk"
                    android:textSize="11sp"
                    android:paddingBottom="8dp" />

                <Button
                    android:id="@+id/dgKur"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/dg_kur"
                    android:textStyle="bold"
                    android:textColor="@color/baslik_renk"
                    android:backgroundTint="@color/vurgu" />
            </LinearLayout>

            <!-- KIMLIK / denetim karti (kimlik varken) -->
            <LinearLayout
                android:id="@+id/kartKimlik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/kart_zemin"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kimlik_baslik"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/kehribar"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/etiketKimlik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tel_deger_yok"
                    android:textAppearance="@style/Metin.Mono"
                    android:textSize="12sp"
                    android:paddingBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/dgBaslat"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="@string/dg_baglan"
                        android:textStyle="bold"
                        android:textColor="@color/baslik_renk"
                        android:backgroundTint="@color/vurgu" />

                    <Button
                        android:id="@+id/dgKes"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="@string/dg_kes"
                        android:textColor="@color/govde_renk" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/kutuOto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/alan_oto_baslat"
                    android:textColor="@color/govde_renk" />

                <!-- Kamera mercek secimi (on / arka) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/alan_mercek"
                    android:textAppearance="@style/Metin.Govde"
                    android:textColor="@color/soluk"
                    android:textSize="12sp"
                    android:paddingTop="6dp" />

                <RadioGroup
                    android:id="@+id/grupMercek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioArka"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true"
                        android:text="@string/mercek_arka"
                        android:textColor="@color/govde_renk" />

                    <RadioButton
                        android:id="@+id/radioOn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/mercek_on"
                        android:textColor="@color/govde_renk" />
                </RadioGroup>

                <Button
                    android:id="@+id/dgKimlikSil"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/dg_kimlik_sil"
                    android:textColor="@color/kotu"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Gunluk karti -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/kart_zemin"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/gunluk_baslik"
                        android:textAppearance="@style/Metin.Mono"
                        android:textColor="@color/kehribar"
                        android:textSize="11sp"
                        android:letterSpacing="0.12" />

                    <Button
                        android:id="@+id/dgGunlukTemizle"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:text="@string/dg_gunluk_temizle"
                        android:textColor="@color/soluk"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/etiketGunluk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gunluk_bos"
                    android:textAppearance="@style/Metin.Mono"
                    android:textColor="@color/soluk"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
